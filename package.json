{
  "name": "ttreport-individual",
  "version": "0.1.0",
  "private": true,
  "description": "WTT individual match formatter MVP web app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node -r ./runtime_legacy_ittf_patch.js server.js",
    "start:admin": "ADMIN_TOKEN=secret-token PORT=3001 node -r ./runtime_legacy_ittf_patch.js server.js",
    "cli": "node -r ./runtime_legacy_ittf_patch.js extract_individual_matches.js",
    "index:wtt": "node build_wtt_search_index.js",
    "slim:wtt": "node build_wtt_slim_records.js",
    "fetch:wtt-dates": "node fetch_wtt_calendar_dates.js",
    "update:wtt-dates": "node update_wtt_date_index.js",
    "export:zennihon": "node export_zennihon_archives.js",
    "export:wtt": "node export_wtt_archive.js",
    "crawl:wtt": "node crawl_wtt_archives.js",
    "index:wtt-event": "node update_wtt_event_indexes.js",
    "index:player-records": "node build_player_records_index.js",
    "index:player-record-events": "node -r ./runtime_legacy_ittf_patch.js server.js --build-player-record-event-index",
    "index:player-record-matches": "node -r ./runtime_legacy_ittf_patch.js server.js --build-head-to-head-index",
    "verify:wtt": "node verify_wtt_alignment.js",
    "docs:generate": "node scripts/docs/generate.js"
  }
}
